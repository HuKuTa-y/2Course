<Window x:Class="_2course.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2course"
        mc:Ignorable="d"
        Title="Кодексы и статьи" Height="800" Width="1600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Панель для поиска -->
            <RowDefinition Height="*"/>
            <!-- Основной контент -->
        </Grid.RowDefinitions>
        
        <!-- Основная панель поиска по номеру -->
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0" VerticalAlignment="Top" x:Name="SearchPanel">
            <TextBox x:Name="ArticleNumberTextBox" Width="150" Margin="5" Text="Введите номер статьи" Foreground="Gray" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
            <Button Content="Найти статьи" Margin="5" Click="FindArticlesButton_Click"/>
            <Button Content="Отмена" Margin="5" Click="CancelSearchButton_Click"/>
			<!-- В самом верху, внутри SearchPanel, после кнопки FavoritesButton -->

            <!-- НОВАЯ КНОПКА: Избранное -->
            <Button x:Name="FavoritesButton" Content="⭐ Избранное" Margin="5,5,15,5" Click="FavoritesButton_Click" FontWeight="Bold"/>
			<Button x:Name="NotesMenuButton" Content="📝 Мои заметки" Margin="5,5,15,5" Click="NotesMenuButton_Click" FontWeight="Bold"/>
        </StackPanel>

        <!-- Панель для поиска по словам (во втором ряду) -->
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="1" VerticalAlignment="Top" x:Name="SearchWordsPanel">
            <TextBox x:Name="SearchTextBox" Width="200" Margin="5"/>
            <Button Content="Искать" Margin="5" Click="SearchButton_Click"/>
        </StackPanel>

        <!-- Основной контент -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="350"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
                <ColumnDefinition Width="2.5*" MinWidth="400"/>
                <ColumnDefinition Width="1.5*" MinWidth="460"/>
            </Grid.ColumnDefinitions>

            <!-- Панель для кодексов -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="5">
                <StackPanel x:Name="CodesPanel"/>
            </ScrollViewer>

            <!-- Панель для законов -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="5">
                <StackPanel x:Name="LawsPanel"/>
            </ScrollViewer>

            <!-- Панель для статей -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="5">
                <StackPanel x:Name="ArticlesPanel"/>
            </ScrollViewer>

            <!-- Панель для текста из text_articles.json -->
            <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="5">
                <StackPanel x:Name="ContentStackPanel" />
            </ScrollViewer>
            <StatusBar Grid.Row="2" VerticalAlignment="Bottom" Height="24">
                <TextBlock x:Name="StatusText" Text="Готово" VerticalAlignment="Center" Margin="10,0"/>
            </StatusBar>
        </Grid>
        
    </Grid>
</Window>